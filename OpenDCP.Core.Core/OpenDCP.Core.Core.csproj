<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Roche/dcp-core-platform-be</RepositoryUrl>
    <PackageProjectUrl>https://open-dcp.ai/</PackageProjectUrl>
    <Version>4.6.0</Version>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<Configurations>Debug;Release;develop;dev;stage;test;prod;edu;open</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageReference Include="OpenDCP.Framework.AuditTrail" Version="0.1.0" />
		<PackageReference Include="OpenDCP.Framework.CalculationNode" Version="0.8.1" />
		<PackageReference Include="OpenDCP.Framework.Configuration.Model" Version="0.3.0" />
		<PackageReference Include="OpenDCP.Framework.ConfigurationProvider" Version="0.1.0" />
		<PackageReference Include="OpenDCP.Framework.Dashboard" Version="0.1.1-alpha.2" />
		<PackageReference Include="OpenDCP.Framework.Datasource.Base" Version="0.5.0" />
		<PackageReference Include="OpenDCP.Framework.DataTypes.Analytical" Version="0.3.0" />
		<PackageReference Include="OpenDCP.Framework.DataTypes.Equipment" Version="0.3.0" />
		<PackageReference Include="OpenDCP.Framework.Exceptions" Version="0.1.1" />
		<PackageReference Include="OpenDCP.Framework.FormBuilder" Version="0.1.1" />
		<PackageReference Include="OpenDCP.Framework.Hosting" Version="0.4.0" />
		<PackageReference Include="OpenDCP.Framework.Messaging" Version="0.1.0" />
		<PackageReference Include="OpenDCP.Framework.ServiceDiscovery" Version="0.1.2-alpha.4" />
		<PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.0" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.23" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OpenDCP.Core.DAL\OpenDCP.Core.DAL.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Configurations\users.example.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
