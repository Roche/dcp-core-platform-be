{
  "Debug": {
    "Enabled": true,
    "SanitizeError": false,
    "DisableAuth": true,
    "EnableSwagger": true
  },
  "Host": {
    "EnvironmentSlug": "prod",
    "PluginsPath": "C:\\datasources",
    "IsModuleValidated": true
  },
  "CleanHistoryTables": true,
  "MachineName": "dcp-gxp.example.com",
  "MachineNameNonGxp": "dc-nongxp.example.com",
  "ExternalGateway": {
    "Configuration": {
      "Available": "C:\\DCP\\Platform\\gateway\\Config",
      "Active": "C:\\DCP\\Platform\\gateway\\Active"
    }
  },
  "ServiceDiscoveryProvider": {
    "Driver": "HashiCorpConsul",
    "Settings": {
      "Address": "https://consul.example.com",
      "Port": 8500,
      "SharedConfig": {
        "Paths": {
          "Headers": "headers",
          "MessageBus": "message-bus",
          "MemoryCache": "memory-cache",
          "CredentialStore": "secrets-provider",
          "SupportInfo": "support-info"
        }
      }
    },
    "ServiceConfiguration": {
      "ServiceName": "backend-core-gxp",
      "Address": "dcp-gxp.example.com",
      "Port": 5001,
      "Tags": [
        "gxp",
        "backend",
        "core"
      ]
    }
  },
  "SecretConfigurationProvider": {
    "Settings": {
      "Paths": {
        "Database": "db/core_pgsql",
        "Client": "authorizationServer/core",
        "LDAP": "ldap"
      }
    }
  },
  "IdP": {
    "Driver": "sso",
    "Settings": {
      "Issuer": "https://dcp-gxp.example.com:5001/",
      "SSOIssuer": "DigitalCloneDev",
      "SSOSamlEndpoint": "https://idp.example.com/idp/SSO.saml2",
      "SLOEndpoint": "https://idp.example.com/idp/startSLO.ping?TargetResource=https://dcp.example.com/login",
      "AssertionConsumerServiceURL": "https://dcp-gxp.example.com:8187/api/SSO",
      "SignRequest": false,
      "AllowUntrustedCertificates": false
    },
    "RoleRegex": {
      "Global": "DCP_GLOBAL_(?<Permission>\\w+)",
      "GlobalModule": "DCP_GLOBAL_(?<Module>[\\w-]+)_(?<Permission>\\w+)",
      "Site": "^DCP_(?<SiteShort>[^_]+)_(?<Permission>[^_]+)$",
      "Module": "DCP_(?<SiteShort>\\w+)_(?<Module>[\\w-]+)_(?<Permission>[\\w]+)"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DCP.Framework.Connections.Manager.Pipeline": "Trace"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "OpenDCP.Core": "Verbose",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\Core\\Messages.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3} {Username} {Message:lj}{Exception}{NewLine}"
        }
      }
    ]
  }
}