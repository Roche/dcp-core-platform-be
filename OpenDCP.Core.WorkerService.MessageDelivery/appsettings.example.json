{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "EventLog": {
      "SourceName": "DCPCoreMessageDeliveryService",
      "LogName": "CoreMessageDeliveryDCPServiceLog",
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Host": {
    "EnvironmentSlug": "prod",
    "IsModuleValidated": true
  },
  "MessageChannels": [
    {
      "Driver": "smtp",
      "Settings": {
        "Host": "mailhost.example.com",
        "Port": 25,
        "Sender": "no-reply@dc-dev.example.com"
      }
    }
  ],
  "SecretConfigurationProvider": {
    "Settings": {
      "Paths": {
        "Database": "db/core_pgsql",
        "Client": "authorizationServer/core"
      }
    }
  },
  "ServiceDiscoveryProvider": {
    "Driver": "HashiCorpConsul",
    "Settings": {
      "Address": "https://consul.example.com",
      "Port": 8500,
      "SharedConfig": {
        "Paths": {
          "Headers": "headers",
          "MessageBus": "message-bus",
          "MemoryCache": "memory-cache",
          "CredentialStore": "secrets-provider",
          "SupportInfo": "support-info"
        }
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "OpenDCP.Core": "Verbose",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "E:\\Logs\\Core\\WorkerMessageDelivery.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3} {Username} {Message:lj}{Exception}{NewLine}"
        }
      }
    ]
  }
}